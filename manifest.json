{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "zh_CN",
  "version": "0.8.0",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "idle", "alarms", "favicon", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TimeTrack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  }
}
